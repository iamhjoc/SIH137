# --- Backend API ---------------------------------------------------------
# Dev: leave unset -- Vite's proxy (vite.config.ts) forwards /api to
# http://localhost:8000. Production: set this to your deployed backend's
# public URL, e.g. https://api.yourdomain.com/api/v1
VITE_API_BASE=

# --- Map basemap tiles ----------------------------------------------------
# Optional. Leave blank to use free OSM raster tiles (fine for a demo,
# not for real public traffic -- see OSM's tile usage policy). For
# production, put a paid tile provider's URL template here, e.g.:
#   MapTiler:    https://api.maptiler.com/maps/basic-v2/{z}/{x}/{y}.png
#   Stadia Maps: https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png
# and the matching key below if the provider requires one.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_KEY=
