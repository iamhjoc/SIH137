ENVIRONMENT=production

# --- Database ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sih_user:sih_pass@postgres:5432/sih26137
DATABASE_URL_SYNC=postgresql+psycopg2://sih_user:sih_pass@postgres:5432/sih26137

# --- Redis / Celery -----------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage -----------------------------------------------------
# Use "filesystem" for local/dev only. Use "s3" for any public deployment
# (filesystem storage does not survive container restarts/redeploys and
# is not shared across multiple API/worker instances).
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_PATH=/data/object-storage
S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

DEFAULT_SEED=20260909
LOG_LEVEL=INFO

# --- Public deployment ---------------------------------------------
# Comma-separated origins allowed to call this API from a browser.
# Example: CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
CORS_ALLOWED_ORIGINS=*

# =========================================================================
# PUT YOUR REAL API KEYS BELOW. These are the only values you should need
# to fill in to switch from synthetic/simulated data to real data.
# =========================================================================

# --- 1) OpenStreetMap / road graph --------------------------------------
# OSMnx uses the public Overpass API and needs NO key by default.
# Only set this if you're using a self-hosted or paid Overpass mirror.
OSM_OVERPASS_URL=

# --- 2) Geocoding (address -> lat/lon) ----------------------------------
# GEOCODING_PROVIDER: nominatim | google | mappls
#   nominatim -> free, no key required, GEOCODING_API_KEY can stay blank
#   google    -> https://console.cloud.google.com/  -> enable "Geocoding API"
#   mappls    -> https://apis.mappls.com/console/     -> create a REST API key
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
GEOCODING_API_BASE_URL=

# --- 3) Traffic provider -------------------------------------------------
# TRAFFIC_PROVIDER: tomtom | here | mappls | simulated
#   tomtom -> https://developer.tomtom.com/  -> create an app -> "Traffic API" key
#   here   -> https://platform.here.com/     -> create a project -> REST API key
#   mappls -> https://apis.mappls.com/console/ -> Traffic API key
#   simulated -> keep using the deterministic synthetic traffic generator
TRAFFIC_PROVIDER=simulated
TRAFFIC_API_KEY=
TRAFFIC_API_BASE_URL=
